apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: k8s-dashboard-ngrok
  namespace: {{ k8s_dashboard_service_namespace }}
  labels:
    app.kubernetes.io/managed-by: ngrok-operator
  annotations:
    k8s.ngrok.com/backend-protocol: "HTTPS"
{% if ngrok_access_mode | default('oauth') in ['oauth', 'ip'] %}
    k8s.ngrok.com/traffic-policy: "{{ ngrok_oauth_policy_name }}"
{% endif %}
spec:
  ingressClassName: ngrok
  rules:
    - host: "{{ ngrok_k8s_dashboard_domain }}"
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: {{ k8s_dashboard_service_name }}
                port:
                  number: {{ k8s_dashboard_service_port }}
