apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: dask-dashboard-ngrok
  namespace: {{ dask_dashboard_service_namespace }}
  labels:
    app.kubernetes.io/managed-by: ngrok-operator
{% if ngrok_oauth_enabled | default(false) | bool %}
  annotations:
    k8s.ngrok.com/traffic-policy: "{{ ngrok_oauth_policy_name }}"
{% endif %}
spec:
  ingressClassName: ngrok
  rules:
    - host: "{{ ngrok_dask_domain }}"
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: {{ dask_dashboard_service_name }}
                port:
                  number: {{ dask_dashboard_service_port }}
