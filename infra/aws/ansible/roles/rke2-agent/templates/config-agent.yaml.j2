# RKE2 agent configuration
# Connect directly to control plane for joining (not via load balancer)
server: https://{{ groups['control_plane'][0] }}:9345
token: {{ rke2_token }}

# Use unique node ID suffix to avoid conflicts when replacing workers
with-node-id: true

node-label:
{% for label in node_labels %}
  - {{ label }}
{% endfor %}

# Data directory for local volumes
data-dir: /var/lib/rancher/rke2
