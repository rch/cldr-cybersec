# JupyterHub Helm values
# Generated by Ansible

proxy:
  secretToken: "{{ jupyterhub_proxy_secret }}"
  service:
    type: ClusterIP

hub:
  db:
    type: sqlite-memory  # No persistent storage needed for testing
  config:
{% if jupyterhub_auth_type == 'dummy' %}
    JupyterHub:
      authenticator_class: dummy
    DummyAuthenticator:
      password: ""  # Any password works
{% elif jupyterhub_auth_type == 'google' %}
    JupyterHub:
      authenticator_class: oauthenticator.google.GoogleOAuthenticator
    GoogleOAuthenticator:
      client_id: "{{ jupyterhub_google_client_id }}"
      client_secret: "{{ jupyterhub_google_client_secret }}"
      oauth_callback_url: "https://{{ jupyterhub_ngrok_domain }}/hub/oauth_callback"
      allowed_users:
{% if jupyterhub_google_allowed_email %}
        - "{{ jupyterhub_google_allowed_email }}"
{% endif %}
{% endif %}
{% if jupyterhub_admin_users %}
    Authenticator:
      admin_users:
{% for user in jupyterhub_admin_users %}
        - "{{ user }}"
{% endfor %}
{% endif %}

singleuser:
  image:
    name: "{{ jupyterhub_singleuser_image.split(':')[0] }}"
    tag: "{{ jupyterhub_singleuser_image.split(':')[1] }}"
    pullPolicy: IfNotPresent

  # Allow access to EC2 instance metadata for IAM role credentials
  cloudMetadata:
    blockWithIptables: false

  # Resource limits
  memory:
    limit: "{{ jupyterhub_singleuser_memory_limit }}"
    guarantee: "{{ jupyterhub_singleuser_memory_guarantee }}"
  cpu:
    limit: {{ jupyterhub_singleuser_cpu_limit }}
    guarantee: {{ jupyterhub_singleuser_cpu_guarantee }}

  # Dask integration environment variables
  extraEnv:
    DASK_SCHEDULER_ADDRESS: "{{ jupyterhub_dask_scheduler }}"
    # Dask configuration for better defaults
    DASK_DISTRIBUTED__DASHBOARD__LINK: "http://{{ jupyterhub_dask_scheduler.split(':')[0] }}:8787"
    # S3 storage configuration (uses IAM role for credentials)
    OTEL_DATA_PATH: "s3://{{ jupyterhub_s3_bucket }}/otel/"
    AWS_DEFAULT_REGION: "{{ jupyterhub_aws_region }}"

  # Install requirements from ConfigMap at startup
  # This adds ~1-2 min to pod startup but avoids custom image builds
  lifecycleHooks:
    postStart:
      exec:
        command:
          - "sh"
          - "-c"
          - |
            pip install --quiet --user -r /requirements/requirements.txt 2>/dev/null || true
            # Copy sample notebooks to home directory (editable)
            # -L follows symlinks (ConfigMap uses symlinks)
            # -n no-clobber (don't overwrite user edits)
            # Original stays in sample-notebooks/ as read-only reference
            cp -rLn /home/jovyan/sample-notebooks/*.ipynb /home/jovyan/ 2>/dev/null || true

  # Default URL to open JupyterLab instead of classic notebook
  defaultUrl: "/lab"

  # Storage for user notebooks - disabled for testing (no storage provisioner)
  storage:
    type: none
{% if jupyterhub_deploy_notebooks | default(false) %}
    extraVolumes:
      - name: sample-notebooks
        configMap:
          name: sample-notebooks
      - name: requirements
        configMap:
          name: {{ jupyterhub_requirements_configmap }}
    extraVolumeMounts:
      - name: sample-notebooks
        mountPath: /home/jovyan/sample-notebooks
        readOnly: true
      - name: requirements
        mountPath: /requirements
        readOnly: true
{% else %}
    extraVolumes:
      - name: requirements
        configMap:
          name: {{ jupyterhub_requirements_configmap }}
    extraVolumeMounts:
      - name: requirements
        mountPath: /requirements
        readOnly: true
{% endif %}

  # Network policy - allow egress to Dask scheduler
  networkPolicy:
    enabled: true
    egress:
      # Allow connections to Dask scheduler in dask namespace
      - to:
          - namespaceSelector:
              matchLabels:
                kubernetes.io/metadata.name: dask
        ports:
          - port: 8786
            protocol: TCP
          - port: 8787
            protocol: TCP
          - port: 8788
            protocol: TCP

# Scheduling configuration
scheduling:
  userScheduler:
    enabled: false  # Simple setup, no user scheduler
  userPlaceholder:
    enabled: false  # No placeholder pods

# Culling idle servers
cull:
  enabled: true
  timeout: 3600      # 1 hour
  every: 300         # Check every 5 minutes
  maxAge: 28800      # 8 hours max

# Disable pre-puller for faster initial deployment
prePuller:
  hook:
    enabled: false
  continuous:
    enabled: false

# Debug mode (disable for production)
debug:
  enabled: false
