apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: panel-viz-hpa
  namespace: {{ panel_namespace }}
  labels:
    app: panel-viz
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: panel-viz
  minReplicas: {{ panel_min_replicas }}
  maxReplicas: {{ panel_max_replicas }}
  metrics:
    - type: Resource
      resource:
        name: cpu
        target:
          type: Utilization
          averageUtilization: {{ panel_hpa_cpu_threshold }}
    - type: Resource
      resource:
        name: memory
        target:
          type: Utilization
          averageUtilization: {{ panel_hpa_memory_threshold }}
  behavior:
    scaleUp:
      stabilizationWindowSeconds: 60
      policies:
        - type: Pods
          value: 2
          periodSeconds: 60
    scaleDown:
      stabilizationWindowSeconds: 300
      policies:
        - type: Pods
          value: 1
          periodSeconds: 120
