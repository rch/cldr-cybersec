apiVersion: batch/v1
kind: Job
metadata:
  name: datagen-large
  namespace: {{ datagen_namespace }}
  labels:
    app: datagen
    phase: large
spec:
  activeDeadlineSeconds: {{ datagen_large_deadline_seconds }}
  ttlSecondsAfterFinished: 86400
  backoffLimit: {{ datagen_large_parallelism | int * 2 }}
  completions: {{ datagen_large_parallelism }}
  parallelism: {{ datagen_large_parallelism }}
  completionMode: Indexed
  template:
    metadata:
      labels:
        app: datagen
        phase: large
    spec:
      restartPolicy: OnFailure
      containers:
        - name: datagen
          image: "{{ datagen_image }}"
          imagePullPolicy: IfNotPresent
          command:
            - "python"
            - "-c"
          args:
            - |
              """Parallel vectorized OTEL dataset generator.

              Runs as an indexed K8s Job. Each pod generates its shard of batches
              using numpy vectorized operations for ~10x speedup over pure Python.
              Per-pod progress tracking in S3 enables resume on pod restart.
              The last pod to finish writes the _active_dataset.json marker.
              """
              import json
              import os
              import random
              import sys
              import time
              from datetime import datetime, timedelta, timezone

              import numpy as np
              import pyarrow as pa
              import pyarrow.parquet as pq
              from pyarrow import fs

              # Configuration from Ansible
              BATCHES = {{ datagen_large_batches }}
              SPANS_PER_BATCH = {{ datagen_large_spans_per_batch }}
              CHUNK_SIZE = {{ datagen_large_chunk_size }}
              ROW_GROUP_SIZE = {{ datagen_large_row_group_size }}
              COMPRESSION = "{{ datagen_large_compression }}"
              COMPRESSION_LEVEL = {{ datagen_large_compression_level }}
              BUCKET = "{{ datagen_s3_bucket }}"
              PREFIX = "{{ datagen_large_s3_prefix }}"
              DURATION_DAYS = {{ datagen_large_duration_days }}

              # Pod identity from K8s Indexed Job
              POD_INDEX = int(os.environ.get("JOB_COMPLETION_INDEX", "0"))
              POD_COUNT = {{ datagen_large_parallelism }}

              # Compute this pod's batch IDs (interleaved sharding)
              my_batches = list(range(POD_INDEX, BATCHES, POD_COUNT))
              total_spans_all = BATCHES * SPANS_PER_BATCH

              print("=" * 60)
              print(f"OTEL Large Dataset Generator - Pod {POD_INDEX + 1}/{POD_COUNT}")
              print("=" * 60)
              print(f"Target: s3://{BUCKET}/{PREFIX}/")
              print(f"Total batches: {BATCHES} ({len(my_batches)} assigned to this pod)")
              print(f"Spans per batch: {SPANS_PER_BATCH:,} ({(SPANS_PER_BATCH + CHUNK_SIZE - 1) // CHUNK_SIZE} chunks of {CHUNK_SIZE:,})")
              print(f"Total spans (all pods): {total_spans_all:,}")
              print(f"This pod's spans: {len(my_batches) * SPANS_PER_BATCH:,}")
              print(f"Estimated total size: ~{(total_spans_all * 100) / (1024**4):.2f} TiB")
              print(f"Peak memory per chunk: ~{CHUNK_SIZE * 1500 / (1024**3):.1f} GiB")
              print(f"Compression: {COMPRESSION} (level {COMPRESSION_LEVEL})")
              print(f"Row group size: {ROW_GROUP_SIZE:,}")
              print(f"Partitioning: date-only (hour pruned via row-group stats)")
              print("=" * 60)
              sys.stdout.flush()

              # Schema
              _span_kind_dict = pa.dictionary(pa.int8(), pa.string())
              _status_code_dict = pa.dictionary(pa.int8(), pa.string())

              SPANS_SCHEMA = pa.schema([
                  pa.field("trace_id", pa.string(), nullable=False),
                  pa.field("span_id", pa.string(), nullable=False),
                  pa.field("parent_span_id", pa.string(), nullable=True),
                  pa.field("start_time_unix_nano", pa.int64(), nullable=False),
                  pa.field("end_time_unix_nano", pa.int64(), nullable=False),
                  pa.field("duration_ns", pa.int64(), nullable=False),
                  pa.field("name", pa.string(), nullable=False),
                  pa.field("kind", _span_kind_dict, nullable=False),
                  pa.field("status_code", _status_code_dict, nullable=False),
                  pa.field("status_message", pa.string(), nullable=True),
                  pa.field("service_name", pa.string(), nullable=False),
                  pa.field("service_namespace", pa.string(), nullable=True),
                  pa.field("service_version", pa.string(), nullable=True),
                  pa.field("host_name", pa.string(), nullable=True),
                  pa.field("host_ip", pa.string(), nullable=True),
                  pa.field("attributes_json", pa.string(), nullable=True),
                  pa.field("resource_attributes_json", pa.string(), nullable=True),
                  pa.field("http_method", pa.string(), nullable=True),
                  pa.field("http_status_code", pa.int16(), nullable=True),
                  pa.field("http_url", pa.string(), nullable=True),
                  pa.field("http_route", pa.string(), nullable=True),
                  pa.field("http_target", pa.string(), nullable=True),
                  pa.field("db_system", pa.string(), nullable=True),
                  pa.field("db_name", pa.string(), nullable=True),
                  pa.field("db_operation", pa.string(), nullable=True),
                  pa.field("db_statement", pa.string(), nullable=True),
                  pa.field("rpc_system", pa.string(), nullable=True),
                  pa.field("rpc_service", pa.string(), nullable=True),
                  pa.field("rpc_method", pa.string(), nullable=True),
                  pa.field("messaging_system", pa.string(), nullable=True),
                  pa.field("messaging_destination", pa.string(), nullable=True),
                  pa.field("messaging_operation", pa.string(), nullable=True),
                  pa.field("exception_type", pa.string(), nullable=True),
                  pa.field("exception_message", pa.string(), nullable=True),
                  pa.field("events_count", pa.int32(), nullable=True),
                  pa.field("links_count", pa.int32(), nullable=True),
              ])

              SERVICE_TEMPLATES = [
                  {"name": "api-gateway", "kind": "SERVER", "operations": ["HTTP request", "route", "rate-limit"]},
                  {"name": "auth-service", "kind": "SERVER", "operations": ["validate_token", "refresh_token", "login", "logout"]},
                  {"name": "user-service", "kind": "SERVER", "operations": ["get_user", "update_user", "list_users", "delete_user"]},
                  {"name": "order-service", "kind": "SERVER", "operations": ["create_order", "get_order", "process_order", "cancel_order"]},
                  {"name": "inventory-service", "kind": "SERVER", "operations": ["check_stock", "reserve_item", "release_item"]},
                  {"name": "payment-service", "kind": "SERVER", "operations": ["process_payment", "refund", "validate_card"]},
                  {"name": "notification-service", "kind": "PRODUCER", "operations": ["send_email", "send_sms", "send_push"]},
                  {"name": "shipping-service", "kind": "SERVER", "operations": ["calculate_shipping", "create_shipment", "track"]},
                  {"name": "analytics-service", "kind": "CONSUMER", "operations": ["process_event", "aggregate", "report"]},
                  {"name": "database", "kind": "CLIENT", "operations": ["SELECT", "INSERT", "UPDATE", "DELETE"]},
                  {"name": "cache", "kind": "CLIENT", "operations": ["GET", "SET", "DEL", "MGET", "SCAN"]},
                  {"name": "message-queue", "kind": "PRODUCER", "operations": ["publish", "consume", "ack", "nack"]},
              ]

              # Pre-compute flat arrays for vectorized lookups
              SVC_NAMES = [s["name"] for s in SERVICE_TEMPLATES]
              SVC_KINDS = [s["kind"] for s in SERVICE_TEMPLATES]
              # Build flat operation list with service index mapping
              SVC_OPS = []
              SVC_OP_IDX = []
              for si, s in enumerate(SERVICE_TEMPLATES):
                  for op in s["operations"]:
                      SVC_OPS.append(op)
                      SVC_OP_IDX.append(si)
              SVC_OPS = np.array(SVC_OPS)
              SVC_OP_IDX = np.array(SVC_OP_IDX)

              HTTP_METHODS = np.array(["GET", "POST", "PUT", "DELETE", "PATCH"])
              HTTP_ROUTES = np.array([
                  "/api/users", "/api/users/{id}", "/api/orders", "/api/orders/{id}",
                  "/api/products", "/api/products/{id}", "/api/auth/login", "/api/auth/logout",
                  "/api/health", "/api/metrics", "/api/cart", "/api/checkout",
              ])
              HTTP_STATUS_CODES = np.array([200, 200, 200, 200, 201, 204, 400, 401, 403, 404, 500, 502, 503], dtype=np.int16)
              EXCEPTION_TYPES = ["RuntimeError", "ValueError", "TimeoutError", "ConnectionError"]
              EXCEPTION_MSGS = ["Something went wrong", "Connection refused", "Timeout exceeded", "Service unavailable"]

              service_count = len(SERVICE_TEMPLATES)

              # Initialize S3
              # If env vars are unset/empty, fall through to the default
              # credential chain (EC2 instance role). If STS creds are
              # provided we MUST pass session_token, or pyarrow sends the
              # access key without it and S3 rejects with "InvalidAccessKeyId".
              _ak = os.environ.get("AWS_ACCESS_KEY_ID", "")
              _sk = os.environ.get("AWS_SECRET_ACCESS_KEY", "")
              _st = os.environ.get("AWS_SESSION_TOKEN", "")
              _s3_kwargs = {"region": os.environ.get("AWS_REGION", "us-east-1")}
              if _ak and _sk:
                  _s3_kwargs["access_key"] = _ak
                  _s3_kwargs["secret_key"] = _sk
                  if _st:
                      _s3_kwargs["session_token"] = _st
              s3 = fs.S3FileSystem(**_s3_kwargs)
              base_path = f"{BUCKET}/{PREFIX}"

              # Per-pod progress tracking in S3
              progress_key = f"{base_path}/_progress_{POD_INDEX}.json"
              try:
                  with s3.open_input_stream(progress_key) as f:
                      progress = json.loads(f.read().decode())
                  completed = set(progress.get("completed_batches", []))
                  print(f"Resuming: {len(completed)}/{len(my_batches)} batches already complete")
              except:
                  progress = {"completed_batches": [], "total_bytes": 0, "total_spans": 0}
                  completed = set()

              # Time range
              end_time = datetime.now(timezone.utc)
              start_time = end_time - timedelta(days=DURATION_DAYS)
              time_range_ns = DURATION_DAYS * 24 * 3600 * 1_000_000_000
              start_ns = int(start_time.timestamp() * 1_000_000_000)

              # Stagger pod starts to avoid S3 SLOW_DOWN from concurrent prefix creation
              stagger = POD_INDEX * 5  # 5 seconds between each pod's start
              print(f"Staggering start by {stagger}s (pod {POD_INDEX})")
              sys.stdout.flush()
              time.sleep(stagger)

              overall_start = time.time()

              def write_with_retry(table, root_path, batch_id, pod_index, max_retries=8, chunk_idx=None):
                  """Write shard-partitioned Hive parquet — date-only, sorted, ZSTD.

                  Layout: root_path/shard=podNN/date=YYYY-MM-DD/batch_NNNN_chunk_CC.parquet

                  Hour-level pruning uses row-group statistics on sorted start_time_unix_nano
                  instead of Hive partitioning. This produces ~24x fewer files while enabling
                  the same read-side filtering granularity via predicate pushdown.
                  """
                  import pyarrow.compute as pc

                  # Sort by timestamp for contiguous row groups (enables predicate pushdown)
                  sort_indices = pc.sort_indices(table, sort_keys=[("start_time_unix_nano", "ascending")])
                  table = table.take(sort_indices)

                  shard_path = f"{root_path}/shard=pod{pod_index:02d}"
                  date_col = table.column("date")

                  # Drop partition columns from data (date encoded in path, hour dropped)
                  data_cols = [c for c in table.column_names if c not in ("date", "hour")]

                  unique_dates = pc.unique(date_col).to_pylist()

                  for date_val in unique_dates:
                      date_mask = pc.equal(date_col, date_val)
                      partition = table.filter(date_mask).select(data_cols)

                      # Re-sort partition (filter may scramble order)
                      sort_idx = pc.sort_indices(partition, sort_keys=[("start_time_unix_nano", "ascending")])
                      partition = partition.take(sort_idx)

                      if chunk_idx is not None:
                          part_path = f"{shard_path}/date={date_val}/batch_{batch_id:04d}_chunk_{chunk_idx:02d}.parquet"
                      else:
                          part_path = f"{shard_path}/date={date_val}/batch_{batch_id:04d}.parquet"

                      for attempt in range(max_retries):
                          try:
                              pq.write_table(
                                  partition,
                                  part_path,
                                  filesystem=s3,
                                  row_group_size=ROW_GROUP_SIZE,
                                  compression=COMPRESSION,
                                  compression_level=COMPRESSION_LEVEL,
                                  write_statistics=True,
                                  write_page_index=True,
                              )
                              break
                          except OSError as e:
                              if "SLOW_DOWN" in str(e) and attempt < max_retries - 1:
                                  wait = (2 ** attempt) + random.uniform(0, 2)
                                  print(f"[Pod {pod_index}] S3 SLOW_DOWN on batch {batch_id}, retry {attempt + 1}/{max_retries} after {wait:.1f}s")
                                  sys.stdout.flush()
                                  time.sleep(wait)
                              else:
                                  raise
                      del partition

                  return True

              def generate_batch_vectorized(n, batch_id, rng):
                  """Generate n spans using vectorized numpy operations."""
                  # Timing
                  offsets_ns = rng.integers(0, time_range_ns, size=n, dtype=np.int64)
                  span_starts = start_ns + offsets_ns
                  durations = np.clip(
                      rng.exponential(50_000_000, size=n).astype(np.int64),
                      1_000_000, 30_000_000_000,
                  )
                  span_ends = span_starts + durations

                  # Service assignment
                  svc_indices = rng.integers(0, service_count, size=n)
                  is_error = rng.random(size=n) < 0.05

                  # Per-span operation: pick random op that belongs to this span's service
                  # For each span, filter SVC_OP_IDX to matching service, then pick one
                  op_global_indices = rng.integers(0, len(SVC_OPS), size=n)
                  # Re-roll until op matches service (vectorized rejection sampling)
                  mismatched = SVC_OP_IDX[op_global_indices] != svc_indices
                  retries = 0
                  while mismatched.any() and retries < 20:
                      new_indices = rng.integers(0, len(SVC_OPS), size=mismatched.sum())
                      op_global_indices[mismatched] = new_indices
                      mismatched = SVC_OP_IDX[op_global_indices] != svc_indices
                      retries += 1
                  # Fallback: force remaining mismatches to first op of their service
                  if mismatched.any():
                      for idx in np.where(mismatched)[0]:
                          si = svc_indices[idx]
                          candidates = np.where(SVC_OP_IDX == si)[0]
                          op_global_indices[idx] = rng.choice(candidates)

                  names = SVC_OPS[op_global_indices]
                  kinds_arr = np.array(SVC_KINDS)[svc_indices]
                  svc_names_arr = np.array(SVC_NAMES)[svc_indices]

                  # Boolean masks for conditional fields
                  is_server = kinds_arr == "SERVER"
                  is_client = (kinds_arr == "CLIENT")
                  is_producer = kinds_arr == "PRODUCER"
                  is_consumer = kinds_arr == "CONSUMER"
                  is_msg = is_producer | is_consumer

                  # HTTP fields (SERVER spans only)
                  http_method_idx = rng.integers(0, len(HTTP_METHODS), size=n)
                  http_route_idx = rng.integers(0, len(HTTP_ROUTES), size=n)
                  http_status_idx = rng.integers(0, len(HTTP_STATUS_CODES), size=n)

                  # Host fields
                  host_nums = rng.integers(1, 11, size=n)
                  ip_b = rng.integers(1, 256, size=n)
                  ip_c = rng.integers(1, 256, size=n)

                  # Trace/span IDs - fully vectorized random hex via numpy
                  # 16 random bytes -> 32 hex chars (same format as uuid4().hex)
                  trace_raw = rng.bytes(n * 16)
                  trace_ids = [trace_raw[i*16:(i+1)*16].hex() for i in range(n)]
                  span_raw = rng.bytes(n * 8)
                  span_ids = [span_raw[i*8:(i+1)*8].hex() for i in range(n)]

                  # Events/links
                  events_count = rng.integers(0, 4, size=n, dtype=np.int32)
                  links_count = np.zeros(n, dtype=np.int32)

                  # Vectorized column construction using numpy indexing + np.where
                  svc_names_list = svc_names_arr.tolist()
                  names_list = names.tolist()

                  # Status
                  status_codes = np.where(is_error, "ERROR", "OK").tolist()
                  status_msgs = np.where(is_error, "Error occurred", None).tolist()

                  # Host
                  host_names_list = np.char.add(np.char.add(svc_names_arr.astype(str), "-"), np.char.add(host_nums.astype(str), ".example.com")).tolist()
                  host_ips = np.char.add("10.0.", np.char.add(np.char.add(ip_b.astype(str), "."), ip_c.astype(str))).tolist()

                  # HTTP (SERVER only, None otherwise)
                  http_method_vals = HTTP_METHODS[http_method_idx]
                  http_route_vals = HTTP_ROUTES[http_route_idx]
                  http_status_vals = HTTP_STATUS_CODES[http_status_idx]

                  http_methods = np.where(is_server, http_method_vals, None).tolist()
                  http_routes_list = np.where(is_server, http_route_vals, None).tolist()
                  http_statuses = np.where(is_server, http_status_vals, None).tolist()
                  http_urls = np.where(is_server, np.char.add("https://api.example.com", http_route_vals), None).tolist()

                  # Attributes
                  attrs = np.char.add(np.char.add('{"service.name": "', svc_names_arr.astype(str)), '"}').tolist()
                  res_attrs = ['{}'] * n

                  # DB (CLIENT only)
                  db_systems = np.where(is_client, "postgresql", None).tolist()
                  db_names_list = np.where(is_client, "production", None).tolist()
                  db_ops = np.where(is_client, names, None).tolist()

                  # Messaging (PRODUCER/CONSUMER)
                  msg_systems = np.where(is_msg, "kafka", None).tolist()
                  msg_dests = np.where(is_msg, "events", None).tolist()
                  msg_ops = np.where(is_producer, "publish", np.where(is_consumer, "consume", None)).tolist()

                  # Exceptions (error spans only)
                  exc_types = np.where(is_error, "RuntimeError", None).tolist()
                  exc_msgs = np.where(is_error, "Something went wrong", None).tolist()

                  # Compute date/hour for Hive partitioning
                  timestamps_s = span_starts // 1_000_000_000
                  days_since_epoch = (timestamps_s // 86400).astype(np.int32)
                  hours_of_day = ((timestamps_s % 86400) // 3600).astype(np.int8)
                  unique_days = np.unique(days_since_epoch)
                  day_to_str = {}
                  for d in unique_days:
                      dt = datetime.fromtimestamp(int(d) * 86400, tz=timezone.utc)
                      day_to_str[int(d)] = dt.strftime("%Y-%m-%d")
                  date_col = pa.array([day_to_str[int(d)] for d in days_since_epoch], type=pa.string())
                  hour_col = pa.array(hours_of_day, type=pa.int8())

                  kinds_list = kinds_arr.tolist()

                  table = pa.table({
                      "trace_id": pa.array(trace_ids, type=pa.string()),
                      "span_id": pa.array(span_ids, type=pa.string()),
                      "parent_span_id": pa.nulls(n, type=pa.string()),
                      "start_time_unix_nano": pa.array(span_starts),
                      "end_time_unix_nano": pa.array(span_ends),
                      "duration_ns": pa.array(durations),
                      "name": pa.array(names_list, type=pa.string()),
                      "kind": pa.array(kinds_list).dictionary_encode().cast(_span_kind_dict),
                      "status_code": pa.array(status_codes).dictionary_encode().cast(_status_code_dict),
                      "status_message": pa.array(status_msgs, type=pa.string()),
                      "service_name": pa.array(svc_names_list, type=pa.string()),
                      "service_namespace": pa.array(["production"] * n, type=pa.string()),
                      "service_version": pa.array(["1.0.0"] * n, type=pa.string()),
                      "host_name": pa.array(host_names_list, type=pa.string()),
                      "host_ip": pa.array(host_ips, type=pa.string()),
                      "attributes_json": pa.array(attrs, type=pa.string()),
                      "resource_attributes_json": pa.array(res_attrs, type=pa.string()),
                      "http_method": pa.array(http_methods, type=pa.string()),
                      "http_status_code": pa.array(http_statuses, type=pa.int16()),
                      "http_url": pa.array(http_urls, type=pa.string()),
                      "http_route": pa.array(http_routes_list, type=pa.string()),
                      "http_target": pa.nulls(n, type=pa.string()),
                      "db_system": pa.array(db_systems, type=pa.string()),
                      "db_name": pa.array(db_names_list, type=pa.string()),
                      "db_operation": pa.array(db_ops, type=pa.string()),
                      "db_statement": pa.nulls(n, type=pa.string()),
                      "rpc_system": pa.nulls(n, type=pa.string()),
                      "rpc_service": pa.nulls(n, type=pa.string()),
                      "rpc_method": pa.nulls(n, type=pa.string()),
                      "messaging_system": pa.array(msg_systems, type=pa.string()),
                      "messaging_destination": pa.array(msg_dests, type=pa.string()),
                      "messaging_operation": pa.array(msg_ops, type=pa.string()),
                      "exception_type": pa.array(exc_types, type=pa.string()),
                      "exception_message": pa.array(exc_msgs, type=pa.string()),
                      "events_count": pa.array(events_count),
                      "links_count": pa.array(links_count),
                      "date": date_col,
                      "hour": hour_col,
                  })

                  return table

              for batch_seq, batch_id in enumerate(my_batches):
                  if batch_id in completed:
                      print(f"[Pod {POD_INDEX}] Batch {batch_id} ({batch_seq + 1}/{len(my_batches)}): Already complete, skipping")
                      continue

                  batch_start = time.time()
                  num_chunks = (SPANS_PER_BATCH + CHUNK_SIZE - 1) // CHUNK_SIZE
                  print(f"[Pod {POD_INDEX}] Batch {batch_id} ({batch_seq + 1}/{len(my_batches)}): "
                        f"Generating {SPANS_PER_BATCH:,} spans in {num_chunks} chunks of {CHUNK_SIZE:,}...")
                  sys.stdout.flush()

                  # Deterministic seed per batch for reproducibility
                  # Same rng object is passed through all chunks, so the sequence is deterministic
                  rng = np.random.default_rng(seed=batch_id * 10000 + POD_INDEX)

                  # Stream sub-batches: generate CHUNK_SIZE spans, write immediately, free memory
                  # Peak memory stays at ~1.5Gi regardless of SPANS_PER_BATCH
                  remaining = SPANS_PER_BATCH
                  batch_bytes = 0

                  for chunk_idx in range(num_chunks):
                      chunk_size = min(CHUNK_SIZE, remaining)
                      remaining -= chunk_size

                      table = generate_batch_vectorized(chunk_size, batch_id, rng)
                      write_with_retry(table, f"{base_path}/spans", batch_id, POD_INDEX,
                                      chunk_idx=chunk_idx)
                      batch_bytes += table.nbytes // 4  # rough ZSTD compression ratio
                      del table

                      if num_chunks > 1 and (chunk_idx + 1) % 2 == 0:
                          print(f"[Pod {POD_INDEX}] Batch {batch_id} chunk {chunk_idx + 1}/{num_chunks} written")
                          sys.stdout.flush()

                  # Update per-pod progress (batch-level, not chunk-level)
                  progress["completed_batches"].append(batch_id)
                  progress["total_bytes"] += batch_bytes
                  progress["total_spans"] += SPANS_PER_BATCH

                  for _retry in range(5):
                      try:
                          with s3.open_output_stream(progress_key) as f:
                              f.write(json.dumps(progress).encode())
                          break
                      except OSError:
                          time.sleep(2 ** _retry + random.uniform(0, 1))

                  batch_elapsed = time.time() - batch_start
                  total_gib = progress["total_bytes"] / (1024**3)
                  pct = (batch_seq + 1) / len(my_batches) * 100
                  rate = SPANS_PER_BATCH / batch_elapsed

                  print(f"[Pod {POD_INDEX}] Batch {batch_id}: {batch_elapsed:.1f}s, {batch_bytes / (1024**2):.0f} MiB, {rate:,.0f} spans/s")
                  print(f"[Pod {POD_INDEX}] Progress: {len(progress['completed_batches'])}/{len(my_batches)} ({pct:.0f}%), {progress['total_spans']:,} spans, {total_gib:.2f} GiB")
                  sys.stdout.flush()

              # Pod complete
              overall_elapsed = time.time() - overall_start
              hours = overall_elapsed / 3600

              print("=" * 60)
              print(f"Pod {POD_INDEX} Generation Complete!")
              print("=" * 60)
              print(f"Time: {hours:.2f} hours")
              print(f"Spans: {progress['total_spans']:,}")
              print(f"Size: {progress['total_bytes'] / (1024**3):.2f} GiB")
              print("=" * 60)

              # Check if all pods are done - last one writes the marker
              all_done = True
              total_spans_global = 0
              total_bytes_global = 0
              for pod_id in range(POD_COUNT):
                  try:
                      pk = f"{base_path}/_progress_{pod_id}.json"
                      with s3.open_input_stream(pk) as f:
                          p = json.loads(f.read().decode())
                      total_spans_global += p.get("total_spans", 0)
                      total_bytes_global += p.get("total_bytes", 0)
                      expected = len(range(pod_id, BATCHES, POD_COUNT))
                      if len(p.get("completed_batches", [])) < expected:
                          all_done = False
                  except:
                      all_done = False

              if all_done:
                  marker = {
                      "dataset": PREFIX,
                      "updated_at": datetime.now(timezone.utc).isoformat(),
                      "phase": "large",
                      "total_spans": total_spans_global,
                      "total_bytes": total_bytes_global,
                  }
                  marker_key = f"{BUCKET}/_active_dataset.json"
                  with s3.open_output_stream(marker_key) as f:
                      f.write(json.dumps(marker).encode())
                  print(f"All {POD_COUNT} pods complete! Updated active dataset marker.")
                  print(f"Total: {total_spans_global:,} spans, {total_bytes_global / (1024**4):.3f} TiB")
                  print("Panel viz will auto-swap to large dataset on next poll")
              else:
                  print(f"Pod {POD_INDEX} done. Other pods still running.")

              sys.stdout.flush()
          envFrom:
            - secretRef:
                name: datagen-aws-credentials
          resources:
            limits:
              memory: "{{ datagen_large_memory_limit }}"
              cpu: "{{ datagen_large_cpu_limit }}"
            requests:
              memory: "{{ datagen_large_memory_request }}"
              cpu: "1"
