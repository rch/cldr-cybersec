# Cybersec Dask Cluster Environment Variables
# Copy to .env and fill in values before deployment

# AWS S3 Access
# For local testing with MinIO, use minioadmin/minioadmin
# For AWS, use IAM credentials or leave empty if using instance profiles
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# S3 Endpoint (leave empty for AWS S3, set for MinIO/LocalStack)
# Local MinIO: http://localhost:9010
# Remote MinIO: http://<minio-host>:9010
S3_ENDPOINT=

# OTel Data Path
# Local: s3://cybersec/otel/
# AWS: s3://cybersec-otel-<your-id>/
OTEL_DATA_PATH=s3://cybersec/otel/

# Dask Cluster
# Local: leave empty for local cluster
# Remote: tcp://scheduler.zndx.org:8786 or tcp://<scheduler-ip>:8786
DASK_SCHEDULER_ADDRESS=

# ngrok (required for external tunnel setup)
NGROK_AUTH_TOKEN=
NGROK_API_KEY=
NGROK_ALLOWED_EMAIL=

# Cloudflare DNS (optional, for custom domains)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# JupyterHub OAuth (optional, for Google authentication)
JUPYTERHUB_GOOGLE_CLIENT_ID=
JUPYTERHUB_GOOGLE_CLIENT_SECRET=
