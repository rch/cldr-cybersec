# Ansible inventory generated by OpenTofu
# SSH to bastion: ssh -i ~/.ssh/${ssh_key_name}.pem ec2-user@${bastion_ip}
# SSH to internal: ssh -J ec2-user@${bastion_ip} ec2-user@<private_ip>

[bastion]
${bastion_ip} ansible_user=ec2-user ansible_host=${bastion_ip}

[control_plane]
%{ for i, ip in control_plane_ips ~}
${ip} ansible_user=ec2-user rke2_type=server node_name=control-plane-${i + 1}
%{ endfor ~}

[workers]
%{ for i, ip in worker_ips ~}
${ip} ansible_user=ec2-user rke2_type=agent node_name=worker-${i + 1}
%{ endfor ~}

[rke2:children]
control_plane
workers

[rke2:vars]
ansible_ssh_private_key_file=~/.ssh/${ssh_key_name}.pem
ansible_ssh_common_args='-o ProxyCommand="ssh -i ~/.ssh/${ssh_key_name}.pem -W %h:%p -o StrictHostKeyChecking=no ec2-user@${bastion_ip}" -o StrictHostKeyChecking=no'
k8s_api_endpoint=${k8s_api_endpoint}

[all:vars]
s3_bucket_name=${s3_bucket_name}
aws_region=${aws_region}

[bastion:vars]
ansible_ssh_private_key_file=~/.ssh/${ssh_key_name}.pem
ansible_ssh_common_args='-o StrictHostKeyChecking=no'
