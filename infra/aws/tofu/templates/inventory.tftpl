# Ansible inventory generated by OpenTofu
# SSH through bastion: ssh -J ec2-user@${bastion_ip} ec2-user@<private_ip>

[bastion]
${bastion_ip} ansible_user=ec2-user ansible_ssh_common_args='-o StrictHostKeyChecking=no'

[control_plane]
%{ for i, ip in control_plane_ips ~}
${ip} ansible_user=ec2-user rke2_type=server node_name=control-plane-${i + 1}
%{ endfor ~}

[workers]
%{ for i, ip in worker_ips ~}
${ip} ansible_user=ec2-user rke2_type=agent node_name=worker-${i + 1}
%{ endfor ~}

[rke2:children]
control_plane
workers

[all:vars]
ansible_ssh_common_args='-o ProxyJump=ec2-user@${bastion_ip} -o StrictHostKeyChecking=no'
k8s_api_endpoint=${k8s_api_endpoint}
