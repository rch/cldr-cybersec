# Example tfvars for cybersec cluster
# Copy to terraform.tfvars and customize
#
# IMPORTANT: These variables are auto-detected by devenv tasks. Do NOT set them here:
#   - aws_region       (default: us-east-1, override with AWS_REGION env var)
#   - ssh_key_name     (auto: cybersec-<prefix>)
#   - developer_prefix (auto: 8-char hash from git email)
#   - developer_email  (auto: from git config user.email)

environment = "dev"
project     = "cybersec"

# Network
vpc_cidr = "10.100.0.0/16"

# Cluster sizing (defaults shown)
control_plane_count         = 3
control_plane_instance_type = "m6i.xlarge"
worker_count                = 3
worker_instance_type        = "m6i.2xlarge"

# Storage
root_volume_size = 100
data_volume_size = 500

# Access (restrict in production)
allowed_ssh_cidrs = ["0.0.0.0/0"]

# Additional tags (Owner is set automatically from developer_email)
# Add any extra tags here - they will be merged with common tags
tags = {
  CostCenter = "your-cost-center"
}
